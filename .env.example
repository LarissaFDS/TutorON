# TutorON — configuração local. Copie para ".env" (na mesma pasta) e preencha.
# O arquivo .env NUNCA vai para o Git (está no .gitignore).

# ---------------------------------------------------------------- obrigatório para o Gemini
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------- livro-texto na RAG (opcional)
# Projeto Supabase com pgvector e a função match_chunks (docs/schema.sql).
# Sem isto, a RAG usa só o acervo local de provas/listas/resoluções.
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------- ajustes (opcionais; os valores abaixo são os padrões)
# Ordem da corrida de modelos Gemini (o primeiro que começar a responder vence).
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite
# Segundos até iniciar o próximo modelo se o atual ainda não respondeu:
# TUTORON_ESCALONAMENTO_S=6
# Segundos até acionar o modelo local se nenhum Gemini respondeu:
# TUTORON_ESPERA_LOCAL_S=20

# Modelo local (Ollama). Depois de treinar com 3-Treinar.bat, troque para tutoron-paa-ft.
# TUTORON_MODELO_LOCAL=tutoron-paa
# Modelo "genérico" local usado no modo validação quando o Gemini está fora:
# TUTORON_MODELO_GENERICO_LOCAL=qwen3:8b
# Raciocínio (thinking) do modelo local: 1 = mais lento e erra menos contas.
# TUTORON_RACIOCINIO_LOCAL=1
# No modo validação o local roda sem raciocínio (os dois lados), para a espera não passar de ~1 min:
# TUTORON_RACIOCINIO_LOCAL_VALIDACAO=0
# Leitura de foto do papel quando nenhum Gemini responder: modelo de visão no Ollama (vazio = só Gemini).
# Instale no Ollama e habilite para que fotos continuem funcionando sem cota do Gemini:
# TUTORON_MODELO_VISAO_LOCAL=qwen2.5vl:3b

# Limite de perguntas por endereço IP a cada 10 minutos. Numa sala de aula todos os alunos
# saem pelo mesmo IP da universidade, por isso o padrão é alto.
# TUTORON_LIMITE_PERGUNTAS_10MIN=300

# ---------------------------------------------------------------- treino (opcional)
# Modelo de base do Hugging Face para o 3-Treinar.bat (deve ser o mesmo do modelo local servido).
# TUTORON_TREINO_BASE=Qwen/Qwen3-8B

# Disciplinas "em validação" (ex.: sd) ficam fora do atendimento normal. Só para testes autorizados:
# TUTORON_LIBERAR_EM_VALIDACAO=sd

# ---------------------------------------------------------------- limite diário e planos
# Tokens por dia no plano grátis (0 = sem limite). Renova à meia-noite (janela de 24 h).
# Planos pagos (simulados, sem cobrança) e preços: backend/cota.py e docs/precificacao-tutoron.md.
# TUTORON_COTA_TOKENS=40000
# TUTORON_COTA_JANELA_H=24
# Plano grátis usa o modelo local primeiro e o Gemini só como reserva (0 = Gemini primeiro para todos):
# TUTORON_GRATIS_LOCAL_PRIMEIRO=1
# Modo administrador (sem limite, modo completo) fora deste PC: abra uma vez https://<seu-link>/dev?chave=<esta chave>
# Quem acessa a partir deste próprio PC (127.0.0.1) já é administrador.
# TUTORON_DEV_CHAVE=

# ---------------------------------------------------------------- link público fixo (docs/LINK-FIXO.md)
# TUTORON_TUNEL=tailscale            # tailscale | cloudflare | rapido (padrão: rapido, endereço muda a cada reinício)
# TUTORON_URL_PUBLICA=https://tutoron.<sua-rede>.ts.net
# TUTORON_TUNEL_TOKEN=               # só para TUTORON_TUNEL=cloudflare (domínio próprio)

# ---------------------------------------------------------------- banco e contas (Supabase)
# Passo a passo: docs/supabase/CONFIGURAR.md. Sem estas variáveis o site funciona como antes (convidado,
# dados só em dados/). NÃO defina SUPABASE_KEY (é do RAG antigo de livros e não é usada).
# SUPABASE_URL=https://<projeto>.supabase.co
# Chave pública (anon/publishable): vai para o navegador, só serve para o login.
# SUPABASE_ANON_KEY=
# Chave de serviço (service_role/secret): SÓ no servidor. Nunca no git, nunca no navegador.
# SUPABASE_SERVICE_KEY=
# 1 = só quem entrou com conta pode perguntar (recomendado na validação).
# TUTORON_EXIGIR_LOGIN=1
# E-mails com acesso ao painel /admin (limite por conta), separados por vírgula.
# TUTORON_ADMINS=voce@exemplo.com,colega@exemplo.com
