# TutorON — configuração local. Copie para ".env" (na mesma pasta) e preencha.
# O arquivo .env NUNCA vai para o Git (está no .gitignore).

# ---------------------------------------------------------------- obrigatório para o Gemini
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------- livro-texto na RAG (opcional)
# Projeto Supabase com pgvector e a função match_chunks (docs/schema.sql).
# Sem isto, a RAG usa só o acervo local de provas/listas/resoluções.
SUPABASE_URL=
SUPABASE_KEY=

# ---------------------------------------------------------------- ajustes (opcionais; os valores abaixo são os padrões)
# Ordem da corrida de modelos Gemini (o primeiro que começar a responder vence).
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite
# Segundos até iniciar o próximo modelo se o atual ainda não respondeu:
# TUTORON_ESCALONAMENTO_S=6
# Segundos até acionar o modelo local se nenhum Gemini respondeu:
# TUTORON_ESPERA_LOCAL_S=20

# Modelo local (Ollama). Depois de treinar com 3-Treinar.bat, troque para tutoron-paa-ft.
# TUTORON_MODELO_LOCAL=tutoron-paa
# Modelo "genérico" local usado no modo validação quando o Gemini está fora:
# TUTORON_MODELO_GENERICO_LOCAL=qwen3:8b
# Raciocínio (thinking) do modelo local: 1 = mais lento e erra menos contas.
# TUTORON_RACIOCINIO_LOCAL=1
# No modo validação o local roda sem raciocínio (os dois lados), para a espera não passar de ~1 min:
# TUTORON_RACIOCINIO_LOCAL_VALIDACAO=0

# Limite de perguntas por endereço IP a cada 10 minutos. Numa sala de aula todos os alunos
# saem pelo mesmo IP da universidade, por isso o padrão é alto.
# TUTORON_LIMITE_PERGUNTAS_10MIN=300

# ---------------------------------------------------------------- endereço público fixo (opcional)
# Sem isto, o 1-Iniciar-Servidor.bat cria um endereço *.trycloudflare.com que muda a cada reinício.
# Para um endereço fixo: crie um túnel no painel da Cloudflare (Zero Trust > Networks > Tunnels),
# aponte o hostname para http://127.0.0.1:8000 e cole o token e o endereço aqui.
# TUTORON_TUNEL_TOKEN=
# TUTORON_URL_PUBLICA=https://tutoron.seudominio.com.br

# ---------------------------------------------------------------- treino (opcional)
# Modelo de base do Hugging Face para o 3-Treinar.bat (deve ser o mesmo do modelo local servido).
# TUTORON_TREINO_BASE=Qwen/Qwen3-8B

# Disciplinas "em validação" (ex.: sd) ficam fora do atendimento normal. Só para testes autorizados:
# TUTORON_LIBERAR_EM_VALIDACAO=sd
