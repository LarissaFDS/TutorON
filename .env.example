# Configuração da IA para o TutorON
# Copie este arquivo para .env e preencha os valores abaixo.

# Define qual provedor de IA utilizar ("real" ou "mock")
TUTORON_AI_PROVIDER=real

# Chave de API do provedor LLM (NUNCA commite a chave real)
TUTORON_LLM_API_KEY=coloque_sua_chave_do_google_ai_studio_aqui

# Nome do modelo a ser utilizado
TUTORON_LLM_MODEL=gemini-3.1-flash-lite

# Modelo de fallback em caso de falha do primário
TUTORON_LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
