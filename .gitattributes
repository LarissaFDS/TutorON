# Scripts do Linux precisam de LF mesmo quando o Git do Windows converte finais de linha.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.pdf binary
*.webp binary
# Espelhos de OCR mantêm espaços da transcrição; não reformatar o dado bruto.
02-acervo/**/*.md whitespace=-blank-at-eol
03-triagem/pacote-revisao/*.md whitespace=-blank-at-eol
*.bat text eol=crlf
*.ps1 text eol=crlf

# Demo offline: arquivo único gerado (scripts/demo_offline.py), com base64 embutido; sem diff de texto.
demo-offline/*.html -diff linguist-generated

# Evidências geradas da auditoria: colapsar no GitHub, mantendo expansão do diff.
eval/results/auditoria-20261102/*/resultados.json linguist-generated=true
eval/results/auditoria-20261102/*/respostas.md linguist-generated=true

# Medições e espelhos gerados; os pareceres manuais continuam expostos no diff.
eval/results/promocao-20261102/comparacao.* linguist-generated=true
